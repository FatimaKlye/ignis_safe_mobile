<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Android 11+ package visibility. Without these declarations url_launcher
        cannot resolve a handler, so the About Us developer profile Email and
        LinkedIn actions would silently do nothing on modern devices.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:label="IGNIS SAFE"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            FIX: Added android:process=":unity" to run UnityPlayerGameActivity in a separate OS process
            WHY: Without this, Unity and Flutter share the same process. When Unity tears down
                 (UnityApplication::DestroyInstance) it calls System.exit(0) to ensure a clean
                 native-library shutdown. System.exit() kills the ENTIRE process, including the
                 Flutter engine and MainActivity — causing "Lost connection to device" in adb and
                 leaving the user with a crashed app instead of returning to the progress screen.
                 With android:process=":unity", Unity runs in com.example.ignis_safe:unity.
                 When Unity calls System.exit(), only the :unity process dies. The main Flutter
                 process (com.example.ignis_safe) stays alive, receives onActivityResult normally,
                 delivers the completion result to Dart, and nav.pop() fires → progress bar updates.
                 startActivityForResult / onActivityResult continue to work across processes via
                 Android's Binder IPC — no changes to MainActivity.kt are required.

            FIX: Changed android:launchMode from "singleTop" to "standard"
            WHY: singleTop (and the FLAG_ACTIVITY_SINGLE_TOP intent flag used in MainActivity)
                 allows Android to call onNewIntent() instead of onCreate() if the Unity activity
                 is still alive in the back stack — for example, when the :unity process survives
                 because System.exit(0) is delayed or not called immediately after finish().
                 When onNewIntent() is called instead of onCreate(), FlutterBridge.Start() is NOT
                 re-executed. The DontDestroyOnLoad FlutterBridge from the previous launch is still
                 alive with _lastLaunchToken set to the previous token. FlutterBridge's
                 TryLoadSceneFromIntent() compares the new token and loads the correct scene via
                 OnApplicationFocus, but if the old object is not cleaned up, two bridges coexist.
                 "standard" (Android's default launchMode) guarantees that every
                 startActivityForResult call creates a brand-new UnityPlayerGameActivity instance
                 via onCreate(). There is no "reuse existing activity" behavior.
                 Multiple simultaneous Unity instances are still prevented by the _isUnityLaunching
                 guard in Flutter — the user cannot tap "Start Simulation" while a scene is running.
        -->
        <activity
            android:name="com.unity3d.player.UnityPlayerGameActivity"
            tools:node="remove" />

        <activity
            android:name=".IgnisUnityPlayerActivity"
            tools:ignore="Instantiatable"
            android:exported="false"
            android:launchMode="standard"
            android:process=":unity"
            android:theme="@style/BaseUnityGameActivityTheme"
            android:screenOrientation="landscape"
            android:hardwareAccelerated="true"
            android:resizeableActivity="false"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|fontScale|layoutDirection|density">
            <meta-data
                android:name="unityplayer.UnityActivity"
                android:value="true" />
            <meta-data
                android:name="android.app.lib_name"
                android:value="game" />
            <meta-data
                android:name="WindowManagerPreference:FreeformWindowSize"
                android:value="@string/FreeformWindowSize_maximize" />
            <meta-data
                android:name="WindowManagerPreference:FreeformWindowOrientation"
                android:value="@string/FreeformWindowOrientation_landscape" />
            <meta-data
                android:name="notch_support"
                android:value="true" />
            <layout
                android:minWidth="400px"
                android:minHeight="300px" />
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

</manifest>
